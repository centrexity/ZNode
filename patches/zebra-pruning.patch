+//! Opt-in removal of old finalized block payloads, never validation state.
+
+use std::collections::BTreeSet;
+
+use zebra_chain::{block::Height, transaction};
+
+use crate::service::finalized_state::{
+    DiskWriteBatch, FromDisk, IntoDisk, ReadDisk, TransactionLocation, WriteDisk,
+};
+
+use super::ZebraDb;
+
+pub(super) const TX_VERSION_COLUMN: &str = "znode_tx_version_by_loc";
+
+struct TransactionVersion(u32);
+
+impl IntoDisk for TransactionVersion {
+    type Bytes = [u8; 4];
+
+    fn as_bytes(&self) -> Self::Bytes {
+        self.0.to_le_bytes()
+    }
+}
+
+impl FromDisk for TransactionVersion {
+    fn from_bytes(bytes: impl AsRef<[u8]>) -> Self {
+        Self(u32::from_le_bytes(
+            bytes
+                .as_ref()
+                .try_into()
+                .expect("stored transaction version is four bytes"),
+        ))
+    }
+}
+
+/// The first height in the retained contiguous finalized history window.
+/// Genesis is always retained separately.
+fn cutoff(tip: Height, keep: u32) -> Height {
+    Height(tip.0.saturating_sub(keep.saturating_sub(1)).max(1))
+}
+
+fn deletion_ranges(
+    from: Height,
+    until: Height,
+    protected: &BTreeSet<Height>,
+) -> Vec<(Height, Height)> {
+    let mut ranges = Vec::new();
+    let mut start = Height(from.0.max(1));
+    if start >= until {
+        return ranges;
+    }
+    for retained in protected.range(start..until) {
+        if start < *retained {
+            ranges.push((start, *retained));
+        }
+        start = Height(retained.0 + 1);
+    }
+    if start < until {
+        ranges.push((start, until));
+    }
+    ranges
+}
+
+impl ZebraDb {
+    /// Delete newly expired bodies in the same atomic batch as the new block.
+    pub(super) fn prepare_history_pruning(&self, batch: &mut DiskWriteBatch, tip: Height) {
+        let Some(keep) = self.config.prune_keep_blocks else {
+            return;
+        };
+        let previous_cutoff = self
+            .finalized_tip_height()
+            .map_or(Height(1), |old| cutoff(old, keep));
+        self.prune_body_range(batch, previous_cutoff, cutoff(tip, keep));
+    }
+
+    /// Catch up after lowering the retention window on restart.
+    pub(super) fn prune_existing_history(&self) -> Result<(), rocksdb::Error> {
+        let (Some(keep), Some(tip)) = (self.config.prune_keep_blocks, self.finalized_tip_height())
+        else {
+            return Ok(());
+        };
+        let until = cutoff(tip, keep);
+        let mut from = Height(1);
+        while from < until {
+            let end = Height(from.0.saturating_add(128).min(until.0));
+            let mut batch = DiskWriteBatch::new();
+            self.prune_body_range(&mut batch, from, end);
+            self.db.write(batch)?;
+            from = end;
+        }
+        self.db.compact_pruned_blocks(cutoff(tip, keep))
+    }
+
+    /// Exact version metadata retained for RPC access to old transparent outputs.
+    pub fn pruned_transaction_version(&self, hash: transaction::Hash) -> Option<u32> {
+        self.config.prune_keep_blocks?;
+        let location = self.transaction_location(hash)?;
+        let cf = self
+            .db
+            .cf_handle(TX_VERSION_COLUMN)
+            .expect("pruned metadata column is registered");
+        self.db
+            .zs_get::<_, _, TransactionVersion>(&cf, &location)
+            .map(|version| version.0)
+    }
+
+    /// Keep the two reference blocks required by upstream's subtree format checks.
+    fn reference_blocks(&self) -> BTreeSet<Height> {
+        self.sapling_subtree_by_index(0u16)
+            .map(|subtree| subtree.end_height)
+            .into_iter()
+            .chain(
+                self.orchard_subtree_by_index(0u16)
+                    .map(|subtree| subtree.end_height),
+            )
+            .collect()
+    }
+
+    fn prune_body_range(&self, batch: &mut DiskWriteBatch, from: Height, until: Height) {
+        let cf = self
+            .db
+            .cf_handle("tx_by_loc")
+            .expect("transaction bodies column is registered");
+        let headers = self
+            .db
+            .cf_handle("block_header_by_height")
+            .expect("block headers column is registered");
+        let versions = self
+            .db
+            .cf_handle(TX_VERSION_COLUMN)
+            .expect("pruned metadata column is registered");
+        for (from, until) in deletion_ranges(from, until, &self.reference_blocks()) {
+            for (location, tx) in self.transactions_by_location_range(
+                TransactionLocation::min_for_height(from)
+                    ..TransactionLocation::min_for_height(until),
+            ) {
+                if !tx.outputs().is_empty() {
+                    batch.zs_insert(&versions, location, TransactionVersion(tx.version()));
+                }
+            }
+            batch.zs_delete_range(
+                &cf,
+                TransactionLocation::min_for_height(from),
+                TransactionLocation::min_for_height(until),
+            );
+            batch.zs_delete_range(&headers, from, until);
+        }
+    }
+
+    /// Periodically compact expired payloads during initial sync.
+    pub(super) fn compact_pruned_history(&self, tip: Height) {
+        if let Some(keep) = self.config.prune_keep_blocks {
+            if tip.0 > keep && tip.0.is_multiple_of(1000) {
+                if let Err(error) = self.db.compact_pruned_blocks(cutoff(tip, keep)) {
+                    tracing::error!(?error, "could not reclaim pruned block SST files");
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use zebra_chain::{
+        block::Block, parameters::Network, serialization::ZcashDeserializeInto,
+        transparent::OutPoint,
+    };
+    use zebra_test::vectors::MAINNET_BLOCKS;
+
+    use crate::{
+        service::finalized_state::{FinalizedState, STATE_COLUMN_FAMILIES_IN_CODE},
+        Config, StateInitError,
+    };
+
+    use super::*;
+
+    #[test]
+    fn pruning_cutoff_preserves_genesis_and_boundary() {
+        assert_eq!(cutoff(Height(0), 1000), Height(1));
+        assert_eq!(cutoff(Height(999), 1000), Height(1));
+        assert_eq!(cutoff(Height(1000), 1000), Height(1));
+        assert_eq!(cutoff(Height(1001), 1000), Height(2));
+        assert_eq!(cutoff(Height(u32::MAX), 1000), Height(u32::MAX - 999));
+    }
+
+    #[test]
+    fn pruning_ranges_keep_reference_blocks_and_exclusive_boundary() {
+        let protected = BTreeSet::from([Height(2), Height(4)]);
+        assert_eq!(
+            deletion_ranges(Height(0), Height(6), &protected),
+            vec![
+                (Height(1), Height(2)),
+                (Height(3), Height(4)),
+                (Height(5), Height(6))
+            ]
+        );
+        assert!(deletion_ranges(Height(2), Height(3), &protected).is_empty());
+        assert!(deletion_ranges(Height(6), Height(1), &protected).is_empty());
+        assert_eq!(
+            deletion_ranges(Height(4), Height(6), &protected),
+            vec![(Height(5), Height(6))]
+        );
+    }
+
+    #[test]
+    fn pruning_cache_is_separate_from_archival_cache() {
+        let archive = Config::default();
+        let pruned = Config {
+            prune_keep_blocks: Some(1000),
+            ..archive.clone()
+        };
+        assert_ne!(
+            archive.db_path("state", 28, &Network::Mainnet),
+            pruned.db_path("state", 28, &Network::Mainnet)
+        );
+        assert_eq!(
+            pruned.db_path("state", 28, &Network::Mainnet),
+            pruned.cache_dir.join("znode-pruned-v1/state/v28/mainnet")
+        );
+    }
+
+    #[test]
+    fn pruning_rejects_small_windows_before_opening_state() {
+        let config = Config {
+            prune_keep_blocks: Some(999),
+            ..Config::ephemeral()
+        };
+        let result = FinalizedState::new(
+            &config,
+            &Network::Mainnet,
+            #[cfg(feature = "elasticsearch")]
+            false,
+        );
+        assert!(matches!(
+            result,
+            Err(StateInitError::PruningWindowTooSmall { .. })
+        ));
+    }
+
+    #[cfg(not(any(feature = "indexer", feature = "elasticsearch")))]
+    #[test]
+    fn pruning_real_blocks_preserves_validation_state_and_survives_reopen() {
+        let _init = zebra_test::init();
+        let cache = tempfile::tempdir().expect("scratch directory can be created");
+        let config = Config {
+            cache_dir: cache.path().to_path_buf(),
+            prune_keep_blocks: Some(1000),
+            ..Config::default()
+        };
+        let mut state = FinalizedState::new_with_debug(&config, &Network::Mainnet, true, false)
+            .expect("fresh pruned state can be created");
+        let blocks: Vec<Arc<Block>> = (0..6)
+            .map(|height| {
+                Arc::new(
+                    MAINNET_BLOCKS
+                        .get(&height)
+                        .expect("early mainnet fixture exists")
+                        .zcash_deserialize_into()
+                        .expect("fixture block is valid"),
+                )
+            })
+            .collect();
+        for block in &blocks {
+            state
+                .commit_finalized_direct(block.clone().into(), None, "pruning-test")
+                .expect("verified fixture chain commits");
+        }
+        let outpoint = OutPoint {
+            hash: blocks[1].transactions[0].hash(),
+            index: 0,
+        };
+        let previous_output = state
+            .db
+            .utxo(&outpoint)
+            .expect("old coinbase is unspent")
+            .utxo
+            .output;
+        let snapshot = || {
+            STATE_COLUMN_FAMILIES_IN_CODE
+                .iter()
+                .filter(|name| **name != "tx_by_loc" && **name != "block_header_by_height")
+                .map(|name| {
+                    let cf = state.db.db.cf_handle(name).expect("column is registered");
+                    let rows: Vec<_> = state
+                        .db
+                        .db
+                        .iterator_cf(&cf, rocksdb::IteratorMode::Start)
+                        .map(|row| row.expect("scratch database reads succeed"))
+                        .collect();
+                    (*name, rows)
+                })
+                .collect::<Vec<_>>()
+        };
+        let preserved = snapshot();
+        let mut batch = DiskWriteBatch::new();
+        state.db.prune_body_range(&mut batch, Height(1), Height(4));
+        state
+            .db
+            .write_batch(batch)
+            .expect("pruning batch commits atomically");
+        state
+            .db
+            .db
+            .compact_pruned_blocks(Height(4))
+            .expect("scratch SST compaction succeeds");
+        assert_eq!(preserved, snapshot());
+        assert_eq!(
+            state.db.pruned_transaction_version(outpoint.hash),
+            Some(blocks[1].transactions[0].version())
+        );
+        assert!(state.db.block(Height(0).into()).is_some());
+        for height in 1..4 {
+            assert!(state.db.block(Height(height).into()).is_none());
+            assert!(state.db.block_and_size(Height(height).into()).is_none());
+            assert!(state.db.block_header(Height(height).into()).is_none());
+            assert_eq!(
+                state.db.hash(Height(height)),
+                Some(blocks[usize::try_from(height).expect("fixture height fits in usize")].hash())
+            );
+        }
+        assert_eq!(state.db.block(Height(4).into()), Some(blocks[4].clone()));
+        assert_eq!(
+            state
+                .db
+                .utxo(&outpoint)
+                .expect("pruning retains UTXO")
+                .utxo
+                .output,
+            previous_output
+        );
+        assert!(state.db.transaction(outpoint.hash).is_none());
+        assert!(state.db.transaction_location(outpoint.hash).is_some());
+        drop(state);
+        let reopened = FinalizedState::new_with_debug(&config, &Network::Mainnet, true, false)
+            .expect("pruned state can reopen");
+        assert!(reopened.db.block(Height(1).into()).is_none());
+        assert_eq!(reopened.db.block(Height(5).into()), Some(blocks[5].clone()));
+        assert_eq!(
+            reopened
+                .db
+                .utxo(&outpoint)
+                .expect("reopened UTXO is retained")
+                .utxo
+                .output,
+            previous_output
+        );
+    }
+}
